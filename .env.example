# ---------------------------------------------------------------------------
# Travel Fee Estimator — environment variables
#
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Every variable here is server-only: nothing is prefixed with NEXT_PUBLIC_,
# which is what guarantees the Google API key and origin address stay private.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Development (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
#
# Production (PostgreSQL — Supabase / Neon free tier). Example:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
#
# Tell Prisma which engine the schema targets. Run `npm run db:provider postgresql`
# after changing this so prisma/schema.prisma matches.
DATABASE_PROVIDER="sqlite"

# --- Authentication (Auth.js / NextAuth v5) --------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
# Public URL of the deployment. Vercel sets this automatically in production;
# set it locally so callbacks resolve correctly.
NEXTAUTH_URL="http://localhost:3000"
# Trust the deployment host header (required on Vercel behind a proxy).
AUTH_TRUST_HOST="true"

# --- Seed administrator ----------------------------------------------------
# Used only by `npm run db:seed` to create the first admin user.
# Change the password immediately after the first login.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe!2024"

# --- Google Maps Platform --------------------------------------------------
# Server-side key with these APIs enabled:
#   - Routes API           (driving distance + duration)
#   - Places API (New)     (address autocomplete, proxied through our backend)
#   - Geocoding API        (optional, used to validate/normalise addresses)
# Restrict the key by IP or by API in the Google Cloud console. Do NOT create a
# browser key: this key is never sent to the client.
GOOGLE_MAPS_API_KEY="your-google-maps-server-key"

# --- Business defaults (seed values only) ----------------------------------
# After the first seed these live in the database and are edited in the admin
# dashboard. The origin address is never returned by any public endpoint.
SEED_ORIGIN_ADDRESS="1600 Amphitheatre Parkway, Mountain View, CA 94043"
SEED_PRICE_PER_MILE="0.80"
SEED_MINIMUM_FEE="30.00"
SEED_MAX_RADIUS_MILES="100"

# --- Rate limiting ---------------------------------------------------------
# Requests allowed per IP within the window (see src/lib/rate-limit.ts).
RATE_LIMIT_MAX_REQUESTS="15"
RATE_LIMIT_WINDOW_SECONDS="60"
